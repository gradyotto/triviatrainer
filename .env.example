# The train loop runs without these. DATABASE_URL persists attempts for
# signed-in users. Clerk keys enable sign-in. Both are optional locally.

# Neon Postgres. DATABASE_URL is the pooled connection the app uses.
# DATABASE_URL_UNPOOLED is the direct connection used by drizzle-kit migrate.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Clerk (Cloud Agent Secrets: NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY, CLERK_SECRET_KEY)
# Target app: app_3LwlHmH4WqlR3b1FicYjDQdI3fh
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Stripe (Phase 2). Prices are created by `npm run stripe:setup` and loaded
# by lookup key, so a price id is not required.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Optional absolute origin for Checkout and portal return URLs.
# Defaults to the request host when unset.
NEXT_PUBLIC_APP_URL=

# Free-plan overrides. Leave blank to use src/config/plans.ts
# (20 questions/day, 3 AI current-events questions/day).
# Bump PLAN_CONFIG_VERSION when you change a limit so conversion cohorts split.
FREE_QUESTIONS_PER_DAY=
FREE_AI_CURRENT_EVENTS_PER_DAY=
PLAN_CONFIG_VERSION=

# Comma-separated Clerk user ids allowed to open /admin/conversion.
ADMIN_CLERK_USER_IDS=

# Review scheduling overrides. Leave blank to use src/config/review.ts
# (20 reviews per session, 10 minutes after a miss, mastered at 21 days).
REVIEW_MAX_PER_SESSION=
REVIEW_LAPSE_DELAY_MINUTES=
REVIEW_MASTERY_INTERVAL_DAYS=

# AI (Phase 4)
OPENAI_API_KEY=

# Observability (optional early)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
SENTRY_DSN=
